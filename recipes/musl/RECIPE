MUSL_VERSION := 1.2.6
MUSL_SHA256 := d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a
MUSL_URL := https://musl.libc.org/releases/musl-$(MUSL_VERSION).tar.gz
MUSL_ARCHIVE := $(CACHE)/sources/musl-$(MUSL_VERSION).tar.gz
MUSL_SRC := third_party/musl-$(MUSL_VERSION)
MUSL_PREPARED := $(MUSL_SRC)/.prepared
MUSL_OBJ := $(BUILD)/musl/obj
MUSL_SYSROOT := $(abspath $(BUILD)/musl/sysroot)
MUSL_CC := $(MUSL_SYSROOT)/bin/musl-gcc
MUSL_AR ?= ar
MUSL_RANLIB ?= ranlib
MUSL_PATCHES := $(sort $(wildcard recipes/musl/patches/*.patch))

$(MUSL_ARCHIVE):
	@mkdir -p $(dir $@)
	curl -fL --retry 3 "$(MUSL_URL)" -o $@

$(MUSL_PREPARED): $(MUSL_ARCHIVE) $(MUSL_PATCHES)
	@printf '%s  %s\n' '$(MUSL_SHA256)' '$<' | sha256sum -c -
	rm -rf $(MUSL_SRC)
	mkdir -p third_party
	tar -xzf $< -C third_party
	@set -e; for p in $(MUSL_PATCHES); do patch -d $(MUSL_SRC) -p1 < "$$p"; done
	@touch $@

$(MUSL_CC): $(MUSL_PREPARED)
	rm -rf $(MUSL_OBJ) $(MUSL_SYSROOT)
	mkdir -p $(MUSL_OBJ)
	cd $(MUSL_OBJ) && CC='$(MUSL_BUILD_CC)' AR='$(MUSL_AR)' RANLIB='$(MUSL_RANLIB)' \
		CFLAGS='$(MUSL_CFLAGS)' \
		$(abspath $(MUSL_SRC))/configure --prefix='$(MUSL_SYSROOT)' \
		--syslibdir='$(MUSL_SYSROOT)/lib' --disable-shared --enable-wrapper=gcc
	$(MAKE) -C $(MUSL_OBJ) -j$$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
	$(MAKE) -C $(MUSL_OBJ) install
