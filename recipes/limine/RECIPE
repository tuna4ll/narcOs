LIMINE_VERSION := 12.9.0
LIMINE_SHA256 := 84059c93b4ea03994af6d614654c7095291388850ea7b258d64f9263abde5557
LIMINE_URL := https://github.com/Limine-Bootloader/Limine/releases/download/v$(LIMINE_VERSION)/limine-binary.tar.gz
LIMINE_ARCHIVE := $(CACHE)/sources/limine-binary-$(LIMINE_VERSION).tar.gz
LIMINE_SRC := third_party/limine-$(LIMINE_VERSION)
LIMINE_PREPARED := $(LIMINE_SRC)/.prepared
LIMINE_TOOL := $(LIMINE_SRC)/limine
LIMINE_PATCHES := $(sort $(wildcard recipes/limine/patches/*.patch))

$(LIMINE_ARCHIVE):
	@mkdir -p $(dir $@)
	curl -fL --retry 3 "$(LIMINE_URL)" -o $@

$(LIMINE_PREPARED): $(LIMINE_ARCHIVE) $(LIMINE_PATCHES)
	@printf '%s  %s\n' '$(LIMINE_SHA256)' '$<' | sha256sum -c -
	rm -rf $(LIMINE_SRC) third_party/limine-binary
	mkdir -p third_party
	tar -xzf $< -C third_party
	mv third_party/limine-binary $(LIMINE_SRC)
	@set -e; for p in $(LIMINE_PATCHES); do patch -d $(LIMINE_SRC) -p1 < "$$p"; done
	@touch $@

$(LIMINE_TOOL): $(LIMINE_PREPARED)
	$(MAKE) -C $(LIMINE_SRC)
